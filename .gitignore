cat << 'EOF' > .gitignore
# Environments & Virtual Envs
.agent/
venv/
.venv/
env/
ENV/

# Secrets & Environment Variables (CRITICAL)
.env
.env*.local
*.env

# GCP & Service Account Keys
*.json
service-account*.json
credentials.json
client_secret*.json

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/
EOF